# ──────────────────────────────────────────────────────────────────────────
# Feiz Food Group — environment template (Roadmap Task 3.1)
# ──────────────────────────────────────────────────────────────────────────
# Copy to `.env` (or a systemd EnvironmentFile) and fill in real values.
# `.env*` is git-ignored except this template — NEVER commit real secrets.
#
# Exposure legend:
#   [server]   only ever available server-side (never in the browser bundle)
#   [browser]  exposed to the browser (NEXT_PUBLIC_*) — must not be a secret
#   [both]     read on both sides (the public value is identical)
#
# Topology: single Node process behind Nginx, supervised by systemd.
# See docs/DEPLOYMENT.md.
# ──────────────────────────────────────────────────────────────────────────

# Runtime environment: "production" | "development" | "test".
NODE_ENV=production

# ── Trusted proxy (REQUIRED in production) ───────────────────────────────
# Set "true" when behind Nginx (the supported topology) so rate limiting can
# attribute requests to clients via X-Real-IP / X-Forwarded-For. Leaving this
# off in production disables per-client rate limiting (flagged by /api/health).
# [server]
TRUST_PROXY=true

# ── GitHub OAuth broker (Decap CMS login) ───────────────────────────────
# Both must be set together, or both left empty (CMS login disabled).
# [server]
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Comma-separated extra OAuth origins (full https origins), e.g.
# https://staging.feizfood.com. Production is fixed to the canonical domain.
# [server, optional]
OAUTH_ALLOWED_ORIGINS=

# ── RFQ email delivery (Resend) ──────────────────────────────────────────
# All three must be set together to deliver RFQ emails.
# [server]
RESEND_API_KEY=
RFQ_TO_EMAIL=sales@example.com
RFQ_FROM_EMAIL=rfp@example.com   # a Resend-verified sender address
# Outbox + timeouts (optional, sensible defaults shown).
# [server, optional]
RFQ_OUTBOX_DIR=.data
RFQ_SEND_TIMEOUT_MS=8000

# ── Cloudflare Turnstile bot protection ─────────────────────────────────
# Site key + secret must be set together. In production a fixed action and the
# approved hostname set are verified server-side (audit SEC-M5).
# [browser]
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# [both] the action the widget renders with and the broker verifies
NEXT_PUBLIC_TURNSTILE_ACTION=rfq-submit
# [server]
TURNSTILE_SECRET_KEY=
# Comma-separated approved widget hostnames; defaults to the site domain + www.
# [server, optional]
TURNSTILE_HOSTNAMES=
# [server, optional]
TURNSTILE_TIMEOUT_MS=5000

# Comma-separated extra RFQ Origins (full https origins), e.g.
# https://staging.feizfood.com. Production accepts the canonical host only.
# [server, optional]
RFQ_ALLOWED_ORIGINS=

# ── Internal outbox retry (cron/systemd timer) ──────────────────────────
# Shared secret required by POST /api/cron/rfq-retry (sent as a Bearer token).
# Generate with: node -e "console.log(require('crypto').randomUUID())"
# Omit to disable cron-triggered retry (lazy in-request retry still runs).
# [server, optional]
CRON_SECRET=

# ── Operator alerting (optional) ────────────────────────────────────────
# Webhook that receives a JSON event when an RFQ delivery permanently fails.
# [server, optional]
OPERATOR_ALERT_WEBHOOK=
